{
  "name": "Jarvis",
  "short_name": "Jarvis",
  "description": "Your personal assistant, by voice or text.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Talk to Jarvis", "url": "/listen", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "New chat", "url": "/new", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
