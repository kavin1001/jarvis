# Claude API key from https://platform.claude.com (Console), not a Pro/Max login.
ANTHROPIC_API_KEY=

# Postgres connection string (Neon, Supabase, Render, or local).
DATABASE_URL=postgres://localhost:5432/jarvis

# Shared secret the app sends as a bearer token. Generate with: openssl rand -hex 32
# The app trades it for a per-device token at setup and does not store it. Treat it like a root password.
JARVIS_APP_TOKEN=

# Fast lane model and effort. Low effort keeps voice replies quick.
FAST_MODEL=claude-opus-5-5
FAST_EFFORT=low
# Optional: model that names conversations (defaults to FAST_MODEL).
TITLE_MODEL=

# Task lane: IDs printed by `npm run setup-agent`.
TASK_AGENT_ID=
TASK_ENVIRONMENT_ID=
# Optional: vault holding website logins and API keys for the task agent.
TASK_VAULT_ID=

# Minutes to wait for you to approve a risky step before denying it.
APPROVAL_TIMEOUT_MINUTES=30

# Optional safety cap: Jarvis pauses for the rest of the day once estimated spend reaches this.
DAILY_BUDGET_USD=5

PORT=8787

# Optional Google connector (Gmail + Calendar). Create an OAuth "Web application" client in Google Cloud
# with redirect URI ${PUBLIC_URL}/oauth/google/callback. See docs/DEPLOY.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public https URL of this backend, e.g. https://jarvis-backend.onrender.com
PUBLIC_URL=
# Encrypts stored OAuth tokens. Generate with: openssl rand -hex 32. Changing it disconnects accounts.
CONNECTOR_SECRET=
