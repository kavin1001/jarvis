# Claude API key from https://platform.claude.com (Console), not a Pro/Max login.
ANTHROPIC_API_KEY=

# Postgres connection string (Neon, Supabase, Render, or local).
DATABASE_URL=postgres://localhost:5432/jarvis

# Shared secret the app sends as a bearer token. Generate with: openssl rand -hex 32
# MVP only; replace with Sign in with Apple/Google before anyone else uses it.
JARVIS_APP_TOKEN=

# Fast lane model and effort. Low effort keeps voice replies quick.
FAST_MODEL=claude-opus-5-5
FAST_EFFORT=low

# Task lane: IDs printed by `npm run setup-agent`.
TASK_AGENT_ID=
TASK_ENVIRONMENT_ID=
# Optional: vault holding website logins and API keys for the task agent.
TASK_VAULT_ID=

# Minutes to wait for you to approve a risky step before denying it.
APPROVAL_TIMEOUT_MINUTES=30

PORT=8787
